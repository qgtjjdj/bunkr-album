<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BunkrAlbum</RootNamespace>
    <AssemblyName>BunkrAlbum</AssemblyName>
    <ApplicationId>com.qgtjjdj.bunkralbum</ApplicationId>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BunkrAlbum.Core\BunkrAlbum.Core.csproj" />
  </ItemGroup>
</Project>
